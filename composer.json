{
    "name": "gungcahyadipp/auto-docs",
    "description": "All-in-one API documentation for Laravel. Bundles Scramble and Scramble Pro.",
    "keywords": [
        "laravel",
        "documentation",
        "openapi",
        "scramble",
        "auto-docs"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Gung Cahyadi",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "myclabs/deep-copy": "^1.12",
        "nikic/php-parser": "^5.0",
        "phpstan/phpdoc-parser": "^1.0|^2.0",
        "spatie/laravel-package-tools": "^1.9.2|^1.16"
    },
    "suggest": {
        "spatie/laravel-data": "Required for Laravel Data documentation support (^4.0)",
        "spatie/laravel-query-builder": "Required for Spatie Query Builder documentation support (^5.0|^6.0)",
        "timacdonald/json-api": "Required for JSON:API resource documentation support (^1.0)",
        "lorisleiva/laravel-actions": "Required for Laravel Actions documentation support (^2.0)",
        "spatie/laravel-json-api-paginate": "Required for JSON:API pagination documentation support (^1.0)"
    },
    "autoload": {
        "psr-4": {
            "GungCahyadiPP\\AutoDocs\\": "src/",
            "Dedoc\\Scramble\\": "packages/scramble/src/",
            "Dedoc\\Scramble\\Database\\Factories\\": "packages/scramble/database/factories/",
            "Dedoc\\ScramblePro\\": "packages/scramble-pro/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GungCahyadiPP\\AutoDocs\\AutoDocsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "GungCahyadiPP\\AutoDocs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
